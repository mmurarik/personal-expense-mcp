{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal Expense API",
    "version": "0.1.0",
    "description": "Single-owner USD expense records in integer cents."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000,
            "description": "Amount in integer US cents. 1250 means $12.50. Must be 1 to 1000000000."
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "description": "ISO currency code. Only USD is supported."
          },
          "expense_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "groceries",
                  "dining",
                  "transport",
                  "housing",
                  "utilities",
                  "health",
                  "shopping",
                  "entertainment",
                  "travel",
                  "education",
                  "other"
                ],
                "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
              },
              {
                "type": "null"
              }
            ],
            "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "The version you last read. The write fails with a conflict if the record changed since."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC timestamp."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC timestamp."
          }
        },
        "required": [
          "id",
          "amount_minor",
          "currency",
          "expense_date",
          "merchant",
          "category",
          "notes",
          "version",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "ExpenseCreate": {
        "type": "object",
        "properties": {
          "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000,
            "description": "Amount in integer US cents. 1250 means $12.50. Must be 1 to 1000000000."
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "description": "ISO currency code. Only USD is supported.",
            "default": "USD"
          },
          "expense_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "description": "Calendar date the expense happened, YYYY-MM-DD, or null if unknown.",
            "default": null
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "Merchant name as the user said it, or null if unknown.",
            "default": null
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "groceries",
                  "dining",
                  "transport",
                  "housing",
                  "utilities",
                  "health",
                  "shopping",
                  "entertainment",
                  "travel",
                  "education",
                  "other"
                ],
                "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
              },
              {
                "type": "null"
              }
            ],
            "description": "Category, or null if unknown. One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other.",
            "default": null
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "description": "Free-text notes, or null.",
            "default": null
          }
        },
        "required": [
          "amount_minor"
        ],
        "additionalProperties": false
      },
      "ExpenseUpdate": {
        "type": "object",
        "properties": {
          "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000,
            "description": "Amount in integer US cents. 1250 means $12.50. Must be 1 to 1000000000."
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "description": "ISO currency code. Only USD is supported."
          },
          "expense_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "description": "Calendar date the expense happened, YYYY-MM-DD, or null if unknown."
          },
          "merchant": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "description": "Merchant name as the user said it, or null if unknown."
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "groceries",
                  "dining",
                  "transport",
                  "housing",
                  "utilities",
                  "health",
                  "shopping",
                  "entertainment",
                  "travel",
                  "education",
                  "other"
                ],
                "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
              },
              {
                "type": "null"
              }
            ],
            "description": "Category, or null if unknown. One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "description": "Free-text notes, or null."
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "The version you last read. The write fails with a conflict if the record changed since."
          }
        },
        "required": [
          "expected_version"
        ],
        "additionalProperties": false,
        "minProperties": 2
      },
      "ListResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "amount_minor": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000,
                  "description": "Amount in integer US cents. 1250 means $12.50. Must be 1 to 1000000000."
                },
                "currency": {
                  "type": "string",
                  "const": "USD",
                  "description": "ISO currency code. Only USD is supported."
                },
                "expense_date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "merchant": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "category": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "groceries",
                        "dining",
                        "transport",
                        "housing",
                        "utilities",
                        "health",
                        "shopping",
                        "entertainment",
                        "travel",
                        "education",
                        "other"
                      ],
                      "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
                },
                "notes": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647,
                  "description": "The version you last read. The write fails with a conflict if the record changed since."
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "RFC 3339 UTC timestamp."
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "RFC 3339 UTC timestamp."
                }
              },
              "required": [
                "id",
                "amount_minor",
                "currency",
                "expense_date",
                "merchant",
                "category",
                "notes",
                "version",
                "created_at",
                "updated_at"
              ],
              "additionalProperties": false
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as cursor to get the next page; null when there are no more."
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Check service liveness",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Check database readiness",
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Database is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/expenses": {
      "post": {
        "summary": "Create an expense",
        "operationId": "createExpense",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reuse this UUID only when retrying the same normalized expense."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original creation receipt replayed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expense"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "const": "true"
                }
              }
            }
          },
          "201": {
            "description": "Expense created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expense"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "409": {
            "description": "Version or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Input failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List active expenses",
        "operationId": "listExpenses",
        "description": "Sorted by creation time and ID, descending. Reuse the same filters when supplying a continuation cursor.",
        "parameters": [
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "date"
                }
              ],
              "description": "Inclusive start date, YYYY-MM-DD. Excludes expenses with no date."
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "date"
                }
              ],
              "description": "Inclusive end date, YYYY-MM-DD. Excludes expenses with no date."
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "enum": [
                    "groceries",
                    "dining",
                    "transport",
                    "housing",
                    "utilities",
                    "health",
                    "shopping",
                    "entertainment",
                    "travel",
                    "education",
                    "other"
                  ],
                  "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
                }
              ],
              "description": "One of: groceries, dining, transport, housing, utilities, health, shopping, entertainment, travel, education, other."
            }
          },
          {
            "name": "merchant",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "maxLength": 200
                }
              ],
              "description": "Case-insensitive literal substring match on merchant name."
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Page size. Defaults to 25.",
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Opaque continuation cursor from the previous page."
                }
              ],
              "description": "Opaque continuation cursor from the previous page."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Expense page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResult"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "422": {
            "description": "Input failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/expenses/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read an active expense",
        "operationId": "getExpense",
        "responses": {
          "200": {
            "description": "Active expense.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expense"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "Active expense not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Input failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update explicitly supplied fields",
        "operationId": "updateExpense",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated expense.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expense"
                }
              }
            }
          },
          "401": {
            "description": "A valid bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "Active expense not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Input failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Soft-delete an expense",
        "operationId": "deleteExpense",
        "parameters": [
          {
            "name": "expected_version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "The version you last read. The write fails with a conflict if the record changed since."
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Expense hidden or already deleted."
          },
          "401": {
            "description": "A valid bearer token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "Active expense not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Input failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
